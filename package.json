{
  "name": "tmp-muhely-hub",
  "version": "2.3.0",
  "description": "TMP Műhely Hub - raktár, javítás, rendelések, kölcsönzés, árajánlat, TO-DO",
  "main": "main.js",
  "author": "TMP Audio",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux",
    "publish": "electron-builder --win --publish always",
    "publish:mac": "electron-builder --mac --publish always"
  },
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "hu.tmpaudio.muhelyhub",
    "productName": "TMP Muhely Hub",
    "copyright": "TMP Audio",
    "directories": {
      "output": "kiadas",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "frissites.js",
      "app/**/*",
      "build/icon.*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TMP Muhely Hub",
      "installerLanguages": [
        "hu_HU"
      ],
      "language": "1038"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.business",
      "identity": null,
      "darkModeSupport": false
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "build/icon.png",
      "category": "Office"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "galcsoni",
        "repo": "tmp-muhely-hub"
      }
    ],
    "dmg": {
      "title": "TMP Muhely Hub",
      "contents": [
        {
          "x": 150,
          "y": 180,
          "type": "file"
        },
        {
          "x": 400,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ]
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}